[Unit]
Description=G2B Server - 나라장터 마켓 인텔리전스 웹서비스
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/work/g2b_agent/server
ExecStart=/home/ubuntu/work/g2b_agent/server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
